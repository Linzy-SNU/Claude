<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.linzy.claude-autosync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/linzy/Claude/scripts/auto-sync.sh</string>
    </array>

    <!-- 5분(300초)마다 실행. 더 자주 원하면 숫자를 줄이세요 (예: 60 = 1분) -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- 맥 로그인 시에도 한 번 실행 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/tmp/claude-autosync.err</string>
</dict>
</plist>
