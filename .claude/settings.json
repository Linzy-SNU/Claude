{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/git-auto-sync.sh\" pull",
            "timeout": 30,
            "statusMessage": "git pull 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/git-auto-sync.sh\" sync",
            "timeout": 60,
            "async": true,
            "statusMessage": "자동 커밋·푸시 중..."
          }
        ]
      }
    ]
  }
}
